$ task release:check BASE=none RELEASE_VERSION=v2.0.0
task: [release:check] dirty=$(git status --porcelain)
if [ -n "$dirty" ]; then
  echo "gorelease needs a clean working tree; commit, stash or remove these paths first (git status --porcelain):" >&2
  printf '%s\n' "$dirty" >&2
  exit 1
fi

task: [release:check] go run golang.org/x/exp/cmd/gorelease@v0.0.0-20261014143641-f0251eb4aa3e -base=none -version=v2.0.0
# summary
v2.0.0 is a valid semantic version for this release.
